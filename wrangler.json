{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sv-closures",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sv-closures"
    }
  ],
  "observability": {
    "enabled": true
  }
}
